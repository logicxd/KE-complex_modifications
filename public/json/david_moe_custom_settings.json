{
    "title": "David's Custom Settings",
    "description": "David's personal custom shortcuts: debug commands for Xcode, Intellij, and VSCode mapped to both Right Control and Right Option, plus additional IDE navigation shortcuts.",
    "author": "Aung David Moe",
    "maintainers": ["logicxd"],
    "rules": [
        {
            "description": "Right Option + Down Arrow -> Step Over",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com\\.apple\\.dt\\.Xcode$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "down_arrow",
                        "modifiers": { "mandatory": ["right_option"] }
                    },
                    "to": [
                        {
                            "key_code": "f6",
                            "modifiers": ["fn"]
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com\\.jetbrains\\.intellij$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "down_arrow",
                        "modifiers": { "mandatory": ["right_option"] }
                    },
                    "to": [
                        {
                            "key_code": "f8",
                            "modifiers": ["fn"]
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.VSCode$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "down_arrow",
                        "modifiers": { "mandatory": ["right_option"] }
                    },
                    "to": [
                        {
                            "key_code": "f10",
                            "modifiers": ["fn"]
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
